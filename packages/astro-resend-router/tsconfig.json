{
	"extends": "astro/tsconfigs/strictest",
	"compilerOptions": {
		"resolveJsonModule": true,
		"baseUrl": ".",
		"paths": {
			"#/*": ["./src/*"]
		},
		"module": "Node16",
		"moduleResolution": "Node16",
		"jsx": "preserve",
		"ignoreDeprecations": "6.0",
		"noUncheckedIndexedAccess": true
	},
	"exclude": ["dist"]
}
