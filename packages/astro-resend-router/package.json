{
	"name": "astro-resend-router",
	"version": "2.1.0",
	"description": "Astro integration for using Resend as an email-based mailing list router",
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./api/astro-resend-router.ts": {
			"types": "./dist/api/astro-resend-router.d.ts",
			"default": "./dist/api/astro-resend-router.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"dev": "tsup --watch",
		"build": "tsup",
		"prepublishOnly": "pnpm build"
	},
	"keywords": [
		"astro-integration",
		"astro-component",
		"withastro",
		"astro",
		"resend",
		"email",
		"mailing-list"
	],
	"author": "Tyler Mykkanen",
	"repository": {
		"type": "git",
		"url": "https://github.com/tmykkanen/astro-resend-router.git"
	},
	"bugs": "https://github.com/tmykkanen/astro-resend-router/issues",
	"homepage": "https://github.com/tmykkanen/astro-resend-router#readme",
	"license": "MIT",
	"peerDependencies": {
		"astro": "^6.0.0",
		"vite": "^7"
	},
	"devDependencies": {
		"tsup": "8.5.1"
	},
	"dependencies": {
		"cheerio": "^1.2.0",
		"openapi-fetch": "^0.17.0",
		"resend": "^6.12.3"
	}
}
